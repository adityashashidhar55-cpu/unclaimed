{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unclaimedgrant",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-14",

  // Static assets + Worker in ONE deployment. Asset requests are free and do
  // not count against the 100k/day Worker request limit — which is why 4,000
  // SEO pages cost nothing. Only /api, /auth and /webhooks run code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*"]
  },

  "observability": { "enabled": true },
  "preview_urls": true,

  // D1, not KV, for entitlements: KV is eventually consistent (~60s) and a
  // user who just paid must never still see the paywall.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unclaimedgrant-prod",
      "database_id": "96793498-0a14-4314-aaa8-227530951494",
      "migrations_dir": "./migrations"
    }
  ],

  // Encrypted document vault. The Worker stores and returns ciphertext it
  // cannot read; keys never leave the user's device. See migrations/0002.
  //
  // Commented out until R2 is enabled on the account. Every vault route checks
  // for the binding and returns 503 without it, so the rest of the product
  // deploys and works meanwhile — a missing bucket must not take sign-in down
  // with it. Uncomment after `Enable R2` in the dashboard.
  // "r2_buckets": [
  //   { "binding": "VAULT", "bucket_name": "unclaimedgrant-vault" }
  // ],

  "vars": {
    "APP_ORIGIN": "https://unclaimedgrant.com",

    // Price ids are public identifiers, not secrets — they appear in the
    // checkout URL either way. Created by `node scripts/stripe-setup.mjs`,
    // which prints the three lines to paste back here.
    "STRIPE_PRICE_PERSONAL_MONTHLY": "price_REPLACE_ME",
    "STRIPE_PRICE_PERSONAL_ANNUAL": "price_REPLACE_ME",
    "STRIPE_PRICE_BUSINESS_MONTHLY": "price_REPLACE_ME",
    "STRIPE_PRICE_BUSINESS_ANNUAL": "price_REPLACE_ME"
  },

  "routes": [
    { "pattern": "unclaimedgrant.com", "custom_domain": true },
    { "pattern": "www.unclaimedgrant.com", "custom_domain": true }
  ]

  // Secrets (never in this file):
  //   wrangler secret put STRIPE_SECRET_KEY
  //   wrangler secret put STRIPE_WEBHOOK_SECRET
  //   wrangler secret put SESSION_SIGNING_KEY
  //   wrangler secret put RESEND_API_KEY        (optional, for magic links)
  //
  // Operator login for /admin/ — run `node scripts/admin-password.mjs <email>`
  // and it prints all three. With any of them unset, /auth/admin returns 503
  // rather than letting anyone in. See docs/ADMIN.md.
  //   wrangler secret put ADMIN_EMAIL
  //   wrangler secret put ADMIN_PASSWORD_SALT
  //   wrangler secret put ADMIN_PASSWORD_HASH
  //
  // Bucket:
  //   wrangler r2 bucket create unclaimedgrant-vault
}
