dist/
node_modules/
.DS_Store

# Generated by native/prepare.mjs and native/gen-assets.py — both run in CI,
# and committing a second copy of the dataset would double the repo.
native/www/
native/resources/
# Capacitor scaffolds these from capacitor.config.json on every build.
native/android/
native/ios/

# The Capacitor Android/iOS projects are generated by `npx cap add` in CI, from
# capacitor.config.json and native/www. Committing them means two sources of
# truth for the same settings, and the one in git is always the stale one.
native/android/
native/ios/
native/node_modules/
native/www/
harvest/pages/
# Store screenshots are generated from native/www by scripts/store-screens.mjs.
# Regenerating them is one command; committing 5MB of PNGs that go stale the
# moment the UI changes is how a listing ends up showing last quarter's app.
store/
